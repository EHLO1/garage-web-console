{
  "name": "garage-webui",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:client": "vite",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:server": "cd backend && air",
    "dev": "concurrently \"pnpm dev:client\" \"pnpm dev:server\"",
    "test:e2e": "pnpm build && playwright test",
    "format": "prettier --write src tests *.ts *.json *.js README.md"
  },
  "dependencies": {
    "@lucide/svelte": "^1.0.0",
    "bits-ui": "2.19.2",
    "clsx": "^2.1.1",
    "svelte": "5.57.0",
    "svelte-sonner": "^1.0.5",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@opentelemetry/api": "^1.9.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "4.0.0-next.4",
    "@sveltejs/kit": "3.0.0-next.27",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "^22.20.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "eslint": "^9.8.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.41",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.9",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.12",
    "vitest": "^4.0.0"
  },
  "imports": {
    "#src/*": "./src/*",
    "#lib/*": "./src/lib/*"
  }
}
